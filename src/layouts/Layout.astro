---
import '../styles/global.css';
import { withBase } from '../config';
import InstagramModal from '../components/InstagramModal.astro';
import ContactModal from '../components/ContactModal.astro';
import logoFull from '../assets/logo-full.png';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'product';
}

const { title, description, ogImage, ogType = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Pages without their own image (home, about, FAQ, …) share the full logo.
// It's square, so it gets Twitter's 'summary' card; product photos keep the
// large card.
const shareImage = ogImage ?? logoFull.src;
const shareImageURL = new URL(shareImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImageURL} />
    {
      !ogImage && (
        <>
          <meta property="og:image:width" content={String(logoFull.width)} />
          <meta property="og:image:height" content={String(logoFull.height)} />
          <meta property="og:image:alt" content="Aarvika 3D logo" />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:image" content={shareImageURL} />
    <slot name="head" />
  </head>
  <body class="font-body bg-ink text-bone antialiased">
    <slot />
    <InstagramModal />
    <ContactModal />
  </body>
</html>

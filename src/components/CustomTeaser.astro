---
import { whatsappLink, withBase } from '../config';

const waHref = whatsappLink('Hi Aarvika 3D — I have something custom I want printed.');
---

<section class="border-t border-line">
  <div class="max-w-6xl mx-auto px-5 py-16 text-center md:py-20">
    <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-coral">Custom work</p>
    <h2 class="mt-3 font-display text-2xl font-medium text-bone md:text-3xl">
      Send us a file, or just describe it
    </h2>
    <p class="mx-auto mt-4 max-w-md text-dust">
      If you have an STL we'll quote from it. If you don't, a photo or a rough
      sketch is enough to start.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={withBase('custom')}
        class="inline-flex items-center rounded-full bg-coral px-5 py-3 text-sm font-medium text-coral-ink transition-colors hover:bg-coral-dp"
      >
        Get a quote
      </a>
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-full border border-line-2 px-5 py-3 text-sm font-medium text-bone transition-colors hover:border-dust"
      >
        Start on WhatsApp
      </a>
    </div>
  </div>
</section>

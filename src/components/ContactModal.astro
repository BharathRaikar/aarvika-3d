---
import { INSTAGRAM_DM_LINK, INSTAGRAM_HANDLE, ORDER_EMAIL, buildMailtoLink, buildWhatsAppLink } from '../config';

const contactMessage = 'Hi Aarvika 3D — I have a question about your prints.';
const channelClass = 'flex items-center gap-3 rounded-xl px-5 py-3.5 transition-colors';
const secondaryClass = `${channelClass} border border-line-2 bg-ink font-medium text-bone hover:border-dust`;
---

<dialog
  id="contact-modal"
  aria-labelledby="contact-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-line-2 bg-ink-2 p-0 text-bone shadow-2xl shadow-black/60 backdrop:bg-black/70 backdrop:backdrop-blur-sm"
>
  <div class="relative p-6">
    <button
      type="button"
      data-contact-close
      aria-label="Close"
      class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full text-dust transition-colors hover:bg-ink-3 hover:text-bone"
    >
      ✕
    </button>

    <h2 id="contact-modal-title" class="font-display text-xl font-medium text-bone">Get in touch</h2>
    <p class="mt-1 text-sm text-dust">Pick where you'd like to reach us:</p>

    <div class="mt-5 flex flex-col gap-3">
      <a
        href={buildWhatsAppLink(contactMessage)}
        target="_blank"
        rel="noopener noreferrer"
        data-contact-channel
        class={`${channelClass} bg-[#25D366] font-semibold text-black hover:bg-[#20ba59]`}
      >
        <svg class="h-5 w-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.886-9.888 9.886m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <span class="flex flex-col">
          <span>Chat on WhatsApp</span>
          <span class="text-xs font-normal opacity-75">+91 86180 62582</span>
        </span>
      </a>

      <a
        href={INSTAGRAM_DM_LINK}
        target="_blank"
        rel="noopener noreferrer"
        data-ig-message={contactMessage}
        data-contact-channel
        class={secondaryClass}
      >
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
        </svg>
        <span class="flex flex-col">
          <span>Message on Instagram</span>
          <span class="text-xs text-dust">@{INSTAGRAM_HANDLE}</span>
        </span>
      </a>

      <a href={buildMailtoLink('Question for Aarvika 3D', contactMessage)} data-contact-channel class={secondaryClass}>
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-10 6L2 7" />
        </svg>
        <span class="flex flex-col">
          <span>Send an Email</span>
          <span class="text-xs text-dust"><!--email_off-->{ORDER_EMAIL}<!--/email_off--></span>
        </span>
      </a>
    </div>
  </div>
</dialog>

<script>
  const contactModal = document.getElementById('contact-modal') as HTMLDialogElement | null;

  // Delegated site-wide: any element with data-contact-modal opens the
  // channel picker instead of going straight to one channel.
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement)?.closest('[data-contact-modal]');
    if (!trigger || !contactModal) return;
    e.preventDefault();
    document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d.close());
    contactModal.showModal();
  });

  contactModal?.querySelector('[data-contact-close]')?.addEventListener('click', () => contactModal.close());

  contactModal?.addEventListener('click', (e) => {
    // Clicking the backdrop (the dialog element itself, outside the panel) closes it.
    if (e.target === contactModal) {
      contactModal.close();
      return;
    }
    // Picking a channel closes the picker, so the Instagram hand-off modal
    // (triggered by data-ig-message) doesn't stack on top of it.
    if ((e.target as HTMLElement).closest('[data-contact-channel]')) contactModal.close();
  });
</script>

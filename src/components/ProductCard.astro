---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { name, price, images, material, printTime } = product.data;
---

<a
  href={`/shop/${product.id}`}
  class="group block overflow-hidden rounded-xl border border-line bg-ink-2 transition-colors hover:border-line-2"
>
  <div class="aspect-square overflow-hidden bg-ink-3">
    <Image
      src={images[0]}
      alt={`${name} — ${material}`}
      widths={[300, 500, 700]}
      sizes="(min-width: 768px) 320px, 50vw"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.045]"
    />
  </div>
  <div class="p-4">
    <h3 class="font-display text-base font-medium text-bone">{name}</h3>
    <div class="mt-2 flex items-center justify-between">
      <span class="text-coral font-medium">₹{price.toLocaleString('en-IN')}</span>
      <span class="font-mono text-[10px] uppercase tracking-[0.13em] text-dust-2">{printTime}</span>
    </div>
  </div>
</a>

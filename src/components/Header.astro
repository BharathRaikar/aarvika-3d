---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { INSTAGRAM_DM_LINK, withBase } from '../config';

const igMessage = "Hi Aarvika 3D — I have a question about your prints.";
---

<div class="bg-coral text-coral-ink text-center text-[11px] font-mono uppercase tracking-[0.14em] py-2 px-4">
  Prototype — prices and photos are placeholders
</div>

<header class="sticky top-0 z-50 bg-ink/90 backdrop-blur border-b border-line">
  <nav class="max-w-6xl mx-auto flex items-center justify-between gap-4 px-5 py-3">
    <a href={withBase('')} class="flex items-center gap-2 shrink-0">
      <Image src={logo} alt="Aarvika 3D" width={32} height={32} class="h-8 w-8" />
      <span class="font-display font-medium text-bone">Aarvika 3D</span>
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm text-dust">
      <a href={withBase('shop')} class="hover:text-bone transition-colors">Shop</a>
      <a href={withBase('custom')} class="hover:text-bone transition-colors">Custom</a>
      <a href={withBase('about')} class="hover:text-bone transition-colors">About</a>
      <a href={withBase('faq')} class="hover:text-bone transition-colors">FAQ</a>
    </div>
    <div class="flex items-center gap-2">
      <a
        href={INSTAGRAM_DM_LINK}
        target="_blank"
        rel="noopener noreferrer"
        data-ig-message={igMessage}
        class="inline-flex items-center rounded-full bg-coral px-4 py-2 text-sm font-medium text-coral-ink transition-colors hover:bg-coral-dp"
      >
        Message us
      </a>
      <details class="relative md:hidden">
        <summary
          class="flex h-9 w-9 list-none items-center justify-center rounded-full border border-line-2 text-bone [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M1 3h14M1 8h14M1 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-40 rounded-xl border border-line bg-ink-2 p-1.5 text-sm">
          <a href={withBase('shop')} class="block rounded-lg px-3 py-2 text-dust hover:bg-ink-3 hover:text-bone">Shop</a>
          <a href={withBase('custom')} class="block rounded-lg px-3 py-2 text-dust hover:bg-ink-3 hover:text-bone">Custom</a>
          <a href={withBase('about')} class="block rounded-lg px-3 py-2 text-dust hover:bg-ink-3 hover:text-bone">About</a>
          <a href={withBase('faq')} class="block rounded-lg px-3 py-2 text-dust hover:bg-ink-3 hover:text-bone">FAQ</a>
        </div>
      </details>
    </div>
  </nav>
</header>

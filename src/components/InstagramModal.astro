---
import { INSTAGRAM_DM_LINK } from '../config';
---

<dialog
  id="ig-modal"
  aria-labelledby="ig-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-line-2 bg-ink-2 p-0 text-bone shadow-2xl shadow-black/60 backdrop:bg-black/70 backdrop:backdrop-blur-sm"
>
  <div class="relative p-6">
    <button
      type="button"
      data-ig-close
      aria-label="Close"
      class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full text-dust transition-colors hover:bg-ink-3 hover:text-bone"
    >
      ✕
    </button>

    <div class="flex items-center gap-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-coral text-coral-ink">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <h2 id="ig-modal-title" class="font-display text-xl font-medium text-bone">Ready to send!</h2>
    </div>

    <p
      id="ig-modal-status"
      class="mt-5 inline-flex rounded-full border border-coral/40 bg-coral/10 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.1em] text-coral"
    >
      ✓ Order message copied to clipboard
    </p>

    <p
      id="ig-modal-preview"
      class="mt-3 max-h-32 select-all overflow-y-auto whitespace-pre-wrap rounded-lg border border-line bg-ink px-4 py-3 text-sm text-dust"
    >
    </p>

    <p class="mt-4 text-sm text-dust">
      When Instagram opens, simply tap the chat box, select <b class="font-medium text-bone">Paste</b>,
      and hit <b class="font-medium text-bone">Send</b>.
    </p>

    <p id="ig-modal-countdown" class="mt-5 text-center font-mono text-[11px] uppercase tracking-[0.13em] text-dust-2" aria-live="polite">
    </p>

    <a
      id="ig-modal-open"
      href={INSTAGRAM_DM_LINK}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 flex items-center justify-center rounded-full bg-coral px-5 py-3 text-sm font-medium text-coral-ink transition-colors hover:bg-coral-dp"
    >
      Open Instagram Chat Now →
    </a>
  </div>
</dialog>

<script>
  import { copyToClipboard } from '../config';
  import { openInstagramHandoff } from '../scripts/igHandoff';

  // Delegated site-wide: any element with data-ig-message copies that text
  // and shows the hand-off modal instead of jumping straight to Instagram.
  // Instagram has no way to pre-fill a DM, so the modal tells the buyer to
  // paste, then opens the thread (auto after 2s, or via the button).
  document.addEventListener('click', async (e) => {
    const el = (e.target as HTMLElement)?.closest<HTMLElement>('[data-ig-message]');
    if (!el) return;
    const message = el.dataset.igMessage;
    if (!message) return;

    e.preventDefault();
    const copied = await copyToClipboard(message);
    openInstagramHandoff(message, copied);
  });
</script>

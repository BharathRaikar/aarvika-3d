---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { whatsappLink } from '../config';

const waHref = whatsappLink("Hi Aarvika 3D — I'd like to start a custom order.");
---

<Layout
  title="Custom orders — Aarvika 3D"
  description="Send an STL, a photo, or just describe what you want made. We'll quote a price and timeline on WhatsApp."
>
  <Header />
  <main>
    <div class="max-w-6xl mx-auto grid gap-12 px-5 py-12 md:grid-cols-2 md:py-16">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-coral">Custom work</p>
        <h1 class="mt-3 font-display text-3xl font-medium text-bone md:text-4xl">
          Send us a file, or just describe it
        </h1>
        <p class="mt-4 max-w-md text-dust">
          If you have an STL we'll quote from it. If you don't, a photo or a rough sketch is
          enough to start — we'll work out whether it's printable and what it'll cost.
        </p>
        <ol class="mt-8 space-y-5">
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-3 font-mono text-xs text-coral">1</span>
            <p class="text-bone"><b class="font-medium">Tell us what you want.</b> <span class="text-dust">A file, a photo, or a paragraph.</span></p>
          </li>
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-3 font-mono text-xs text-coral">2</span>
            <p class="text-bone"><b class="font-medium">We quote.</b> <span class="text-dust">Price and timeline, usually the same day.</span></p>
          </li>
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-3 font-mono text-xs text-coral">3</span>
            <p class="text-bone"><b class="font-medium">We print it.</b> <span class="text-dust">You get a photo before it ships.</span></p>
          </li>
        </ol>
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center rounded-full bg-coral px-5 py-3 text-sm font-medium text-coral-ink transition-colors hover:bg-coral-dp"
        >
          Start on WhatsApp
        </a>
      </div>

      <div class="rounded-xl border border-line bg-ink-2 p-6 md:p-8">
        <h2 class="font-display text-lg font-medium text-bone">Or leave the details here</h2>
        <form id="custom-form" class="mt-5 space-y-5" novalidate>
          <div>
            <label for="cn" class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-[0.13em] text-dust-2">
              Your name
            </label>
            <input
              id="cn"
              name="name"
              type="text"
              placeholder="Meera"
              class="w-full rounded-lg border border-line-2 bg-ink px-4 py-2.5 text-bone placeholder:text-dust-2 focus-visible:border-coral"
            />
          </div>
          <div>
            <label for="cw" class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-[0.13em] text-dust-2">
              WhatsApp number
            </label>
            <input
              id="cw"
              name="whatsapp"
              type="tel"
              placeholder="+91 98765 43210"
              class="w-full rounded-lg border border-line-2 bg-ink px-4 py-2.5 text-bone placeholder:text-dust-2 focus-visible:border-coral"
            />
          </div>
          <div>
            <label for="cd" class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-[0.13em] text-dust-2">
              What do you want made?
            </label>
            <textarea
              id="cd"
              name="description"
              rows="4"
              placeholder="A nameplate for my front door, roughly 30 cm wide, in black."
              class="w-full rounded-lg border border-line-2 bg-ink px-4 py-2.5 text-bone placeholder:text-dust-2 focus-visible:border-coral"
            ></textarea>
          </div>
          <p id="form-error" class="hidden text-sm text-coral">
            Add your number and a short description first.
          </p>
          <button
            type="submit"
            class="flex w-full items-center justify-center rounded-full bg-coral px-5 py-3 text-sm font-medium text-coral-ink transition-colors hover:bg-coral-dp"
          >
            Send enquiry
          </button>
        </form>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { WHATSAPP, customMessage } from '../config';

  const form = document.getElementById('custom-form') as HTMLFormElement;
  const error = document.getElementById('form-error');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const whatsapp = (form.elements.namedItem('whatsapp') as HTMLInputElement).value.trim();
    const description = (form.elements.namedItem('description') as HTMLTextAreaElement).value.trim();
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();

    if (!whatsapp || !description) {
      error?.classList.remove('hidden');
      return;
    }
    error?.classList.add('hidden');

    const message = customMessage(name, description);
    window.open(`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(message)}`, '_blank');
  });

  ['cw', 'cd'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', () => {
      error?.classList.add('hidden');
    });
  });
</script>

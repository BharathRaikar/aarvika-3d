---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { INSTAGRAM_DM_LINK, ORDER_EMAIL, buildWhatsAppLink } from '../config';

const igMessage = "Hi Aarvika 3D — I'd like to start a custom order.";
---

<Layout
  title="Custom orders — Aarvika 3D"
  description="Send an STL, a photo, or just describe what you want made. We'll quote a price and timeline on Instagram."
>
  <Header />
  <main>
    <div class="max-w-6xl mx-auto grid gap-12 px-5 py-12 md:grid-cols-2 md:py-16">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-coral">Custom work</p>
        <h1 class="mt-3 font-display text-3xl font-medium text-bone md:text-4xl">
          Send us a file, or just describe it
        </h1>
        <p class="mt-4 max-w-md text-dust">
          If you have an STL we'll quote from it. If you don't, a photo or a rough sketch is
          enough to start — we'll work out whether it's printable and what it'll cost.
        </p>
        <ol class="mt-8 space-y-5">
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-3 font-mono text-xs text-coral">1</span>
            <p class="text-bone"><b class="font-medium">Tell us what you want.</b> <span class="text-dust">A file, a photo, or a paragraph.</span></p>
          </li>
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-3 font-mono text-xs text-coral">2</span>
            <p class="text-bone"><b class="font-medium">We quote.</b> <span class="text-dust">Price and timeline, usually the same day.</span></p>
          </li>
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-3 font-mono text-xs text-coral">3</span>
            <p class="text-bone"><b class="font-medium">We print it.</b> <span class="text-dust">You get a photo before it ships.</span></p>
          </li>
        </ol>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={buildWhatsAppLink(igMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-full bg-[#25D366] px-5 py-3 text-sm font-semibold text-black transition-colors hover:bg-[#20ba59]"
          >
            Chat on WhatsApp (+91 86180 62582)
          </a>
          <a
            href={INSTAGRAM_DM_LINK}
            target="_blank"
            rel="noopener noreferrer"
            data-ig-message={igMessage}
            class="inline-flex items-center rounded-full border border-line-2 px-5 py-3 text-sm font-medium text-bone transition-colors hover:border-dust"
          >
            Or message on Instagram
          </a>
        </div>
      </div>

      <div class="rounded-xl border border-line bg-ink-2 p-6 md:p-8">
        <h2 class="font-display text-lg font-medium text-bone">Or leave the details here</h2>
        <form id="custom-form" class="mt-5 space-y-5" novalidate>
          <div>
            <label for="cn" class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-[0.13em] text-dust-2">
              Your name
            </label>
            <input
              id="cn"
              name="name"
              type="text"
              placeholder="Meera"
              class="w-full rounded-lg border border-line-2 bg-ink px-4 py-2.5 text-bone placeholder:text-dust-2 focus-visible:border-coral"
            />
          </div>
          <div>
            <label for="cw" class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-[0.13em] text-dust-2">
              Phone number <span class="normal-case text-dust-2">(optional)</span>
            </label>
            <input
              id="cw"
              name="phone"
              type="tel"
              placeholder="+91 98765 43210"
              class="w-full rounded-lg border border-line-2 bg-ink px-4 py-2.5 text-bone placeholder:text-dust-2 focus-visible:border-coral"
            />
          </div>
          <div>
            <label for="cd" class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-[0.13em] text-dust-2">
              What do you want made?
            </label>
            <textarea
              id="cd"
              name="description"
              rows="4"
              placeholder="A nameplate for my front door, roughly 30 cm wide, in black."
              class="w-full rounded-lg border border-line-2 bg-ink px-4 py-2.5 text-bone placeholder:text-dust-2 focus-visible:border-coral"
            ></textarea>
          </div>
          <p id="form-error" class="hidden text-sm text-coral">
            Add a short description first.
          </p>
          <div class="flex flex-wrap gap-3">
            <button
              type="submit"
              id="custom-whatsapp-btn"
              class="flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-5 py-3 text-sm font-medium text-black transition-colors hover:bg-[#20ba59]"
            >
              <svg class="h-4 w-4 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.886-9.888 9.886m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              <span>Send via WhatsApp</span>
            </button>
            <button
              type="button"
              id="custom-ig-btn"
              class="flex flex-1 items-center justify-center gap-2 rounded-full border border-line-2 px-5 py-3 text-sm font-medium text-bone transition-colors hover:border-dust"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
              </svg>
              <span>Continue on Instagram DM</span>
            </button>
            <button
              type="button"
              id="custom-email-btn"
              class="flex flex-1 items-center justify-center rounded-full border border-line-2 px-5 py-3 text-sm font-medium text-bone transition-colors hover:border-dust"
            >
              Send via Email
            </button>
          </div>
          <p class="text-xs text-dust-2">
            WhatsApp opens a chat with your enquiry pre-filled. Instagram opens with your enquiry copied to clipboard — just paste and send. Or email us
            directly at <!--email_off--><a href={`mailto:${ORDER_EMAIL}`} class="text-dust underline underline-offset-2 hover:text-bone">{ORDER_EMAIL}</a><!--/email_off-->.
          </p>
        </form>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { buildMailtoLink, buildWhatsAppLink, customMessage, copyToClipboard } from '../config';
  import { openInstagramHandoff } from '../scripts/igHandoff';

  const form = document.getElementById('custom-form') as HTMLFormElement;
  const error = document.getElementById('form-error');
  const emailButton = document.getElementById('custom-email-btn') as HTMLButtonElement | null;
  const igButton = document.getElementById('custom-ig-btn') as HTMLButtonElement | null;

  function readFormFields() {
    const phone = (form.elements.namedItem('phone') as HTMLInputElement).value.trim();
    const description = (form.elements.namedItem('description') as HTMLTextAreaElement).value.trim();
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    return { name, phone, description };
  }

  // WhatsApp is the primary channel, so it's the form's submit button.
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const { name, phone, description } = readFormFields();

    if (!description) {
      error?.classList.remove('hidden');
      return;
    }
    error?.classList.add('hidden');

    window.open(buildWhatsAppLink(customMessage(name, description, phone)), '_blank', 'noopener,noreferrer');
  });

  igButton?.addEventListener('click', async () => {
    const { name, phone, description } = readFormFields();

    if (!description) {
      error?.classList.remove('hidden');
      return;
    }
    error?.classList.add('hidden');

    const message = customMessage(name, description, phone);
    const copied = await copyToClipboard(message);
    openInstagramHandoff(message, copied);
  });

  emailButton?.addEventListener('click', () => {
    const { name, phone, description } = readFormFields();

    if (!description) {
      error?.classList.remove('hidden');
      return;
    }
    error?.classList.add('hidden');

    const message = customMessage(name, description, phone);
    window.location.href = buildMailtoLink('Custom enquiry', message);
  });

  ['cw', 'cd'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', () => {
      error?.classList.add('hidden');
    });
  });
</script>

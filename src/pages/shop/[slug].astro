---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  INSTAGRAM_DM_LINK,
  ORDER_EMAIL,
  buildMailtoLink,
  buildWhatsAppLink,
  productEmailSubject,
  productMessage,
  withBase,
} from '../../config';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => !data.hidden);
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { name, price, category, images, material, size, description, options, customInputLabel, customInputPlaceholder } =
  product.data;

const CATN: Record<string, string> = {
  wall: 'Wall art',
  light: 'Lamps',
  desk: 'Desk',
  home: 'Home',
  fig: 'Figurines',
};

const igMessage = productMessage(name, price);
const emailLink = buildMailtoLink(productEmailSubject(name), productMessage(name, price));

const orderSteps = [
  { title: 'Choose & Message', body: 'Send us the item and your preferred colour on WhatsApp, Instagram DM or Email.' },
  { title: 'Confirm & UPI', body: 'We confirm filament availability and share a UPI QR code.' },
  { title: 'Print & Ship', body: 'We print your piece, send a photo before dispatch, and ship it out in 3–5 days.' },
];

const ogImageSrc = images[0].src;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  image: new URL(ogImageSrc, Astro.site).toString(),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    price,
    availability: 'https://schema.org/MadeToOrder',
  },
};
---

<Layout
  title={`${name} — Aarvika 3D`}
  description={description}
  ogImage={ogImageSrc}
  ogType="product"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </Fragment>
  <Header />
  <main>
    <div class="max-w-6xl mx-auto px-5 py-10 md:py-14">
      <a href={withBase('shop')} class="text-sm text-dust hover:text-bone transition-colors">← Back to shop</a>

      <div class="mt-6 grid gap-10 md:grid-cols-2">
        <div>
          <div id="gallery-main" class="overflow-hidden rounded-xl border border-line bg-ink-3">
            {
              images.map((img, i) => (
                <Image
                  src={img}
                  alt={`${name} — ${material}`}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 768px) 500px, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class:list={['gallery-slide aspect-square w-full object-cover', { hidden: i !== 0 }]}
                  data-index={i}
                />
              ))
            }
          </div>
          {
            images.length > 1 && (
              <div class="mt-3 flex gap-2">
                {images.map((img, i) => (
                  <button
                    type="button"
                    class="gallery-thumb overflow-hidden rounded-lg border-2 aria-current:border-coral border-transparent"
                    data-index={i}
                    aria-current={i === 0}
                    aria-label={`Show photo ${i + 1} of ${name}`}
                  >
                    <Image src={img} alt="" width={80} height={80} class="h-16 w-16 object-cover" />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-coral">{CATN[category]}</p>
          <h1 class="mt-2 font-display text-2xl font-medium text-bone md:text-3xl">{name}</h1>
          <p class="mt-2 text-xl font-medium text-coral">₹{price.toLocaleString('en-IN')}</p>
          <p class="mt-4 text-dust">{description}</p>

          {
            options.length > 0 && (
              <ul class="mt-5 space-y-1.5 text-sm text-dust">
                {options.map((opt) => (
                  <li class="flex gap-2">
                    <span class="text-coral">·</span>
                    {opt}
                  </li>
                ))}
              </ul>
            )
          }

          {
            customInputLabel && (
              <div class="mt-6">
                <label for="custom-input" class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-[0.13em] text-coral">
                  {customInputLabel}
                </label>
                <input
                  id="custom-input"
                  type="text"
                  maxlength="12"
                  autocomplete="off"
                  placeholder={customInputPlaceholder}
                  data-product-name={name}
                  data-product-price={price}
                  class="w-full rounded-lg border border-line-2 bg-ink px-3 py-2 text-sm text-bone placeholder:text-dust-2 focus-visible:border-coral"
                />
              </div>
            )
          }

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              id="whatsapp-order-btn"
              href={buildWhatsAppLink(igMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-1 items-center justify-center gap-2 rounded-full bg-[#25D366] px-5 py-3 text-sm font-medium text-black transition-colors hover:bg-[#20ba59]"
            >
              <svg class="h-4 w-4 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.886-9.888 9.886m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              <span>Order on WhatsApp</span>
            </a>
            <a
              id="ig-order-btn"
              href={INSTAGRAM_DM_LINK}
              target="_blank"
              rel="noopener noreferrer"
              data-ig-message={igMessage}
              class="flex flex-1 items-center justify-center rounded-full bg-coral px-5 py-3 text-sm font-medium text-coral-ink transition-colors hover:bg-coral-dp"
            >
              Order on Instagram
            </a>
            <a
              id="email-order-btn"
              href={emailLink}
              class="flex flex-1 items-center justify-center rounded-full border border-line-2 px-5 py-3 text-sm font-medium text-bone transition-colors hover:border-dust"
            >
              Order by email
            </a>
          </div>
          <p class="mt-3 text-xs text-dust-2">
            WhatsApp opens a chat with your order pre-filled. Instagram copies a message with this piece, then opens the DM — just paste and send.
            Email opens your mail app with the same message pre-filled. We confirm colour, price
            and timeline before you pay.
          </p>
          <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-dust-2">
            <span>
              Prefer webmail? Write to <span class="text-dust">{ORDER_EMAIL}</span>
            </span>
            <button
              type="button"
              id="copy-email-btn"
              data-email={ORDER_EMAIL}
              class="rounded-full border border-line-2 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.13em] text-dust transition-colors hover:border-dust hover:text-bone"
            >
              Copy email
            </button>
          </p>

          <div class="mt-8 rounded-xl border border-line bg-ink-2 p-5">
            <p class="font-mono text-[10.5px] uppercase tracking-[0.13em] text-dust-2">How ordering works</p>
            <ol class="mt-4 space-y-4">
              {
                orderSteps.map((step, i) => (
                  <li class="flex gap-3">
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-ink-3 font-mono text-[11px] text-coral">
                      {i + 1}
                    </span>
                    <p class="text-sm">
                      <b class="font-medium text-bone">{step.title}</b>
                      <span class="block text-dust">{step.body}</span>
                    </p>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="mt-8 grid grid-cols-2 gap-4 border-t border-line pt-6 text-sm">
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.13em] text-dust-2">Material</span>
              <span class="text-bone">{material}</span>
            </div>
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.13em] text-dust-2">Size</span>
              <span class="text-bone">{size}</span>
            </div>
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.13em] text-dust-2">Dispatch</span>
              <span class="text-bone">Dispatched in 3–5 days</span>
            </div>
          </div>

          <p class="mt-6 text-xs text-dust-2">
            Made to order, so slight variation in layer texture is normal. Wipe with a dry cloth; keep
            away from direct sunlight and hot cars — PLA softens above roughly 55°C. Not dishwasher-safe
            or food-safe.
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { buildMailtoLink, buildWhatsAppLink, copyToClipboard, productEmailSubject, productMessage } from '../../config';
  import { showToast } from '../../scripts/toast';

  const copyEmailBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
  copyEmailBtn?.addEventListener('click', async () => {
    const email = copyEmailBtn.dataset.email ?? '';
    if (await copyToClipboard(email)) {
      showToast(`✓ Copied ${email}`, 2500);
    } else {
      window.prompt('Copy our email address:', email);
    }
  });

  // Products with a custom text box (e.g. a name to print): keep both order
  // buttons' messages in sync with what's typed.
  const customInput = document.getElementById('custom-input') as HTMLInputElement | null;
  const whatsappOrderBtn = document.getElementById('whatsapp-order-btn') as HTMLAnchorElement | null;
  const igOrderBtn = document.getElementById('ig-order-btn');
  const emailOrderBtn = document.getElementById('email-order-btn') as HTMLAnchorElement | null;
  customInput?.addEventListener('input', () => {
    const name = customInput.dataset.productName ?? '';
    const price = Number(customInput.dataset.productPrice);
    const value = customInput.value.trim() || undefined;
    const message = productMessage(name, price, value);
    if (whatsappOrderBtn) whatsappOrderBtn.href = buildWhatsAppLink(message);
    if (igOrderBtn) igOrderBtn.dataset.igMessage = message;
    if (emailOrderBtn) emailOrderBtn.href = buildMailtoLink(productEmailSubject(name, value), message);
  });

  const mainImages = document.querySelectorAll<HTMLElement>('.gallery-slide');
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const index = thumb.dataset.index;
      thumbs.forEach((t) => t.setAttribute('aria-current', String(t.dataset.index === index)));
      mainImages.forEach((img) => {
        img.classList.toggle('hidden', img.dataset.index !== index);
      });
    });
  });
</script>

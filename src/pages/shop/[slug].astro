---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { whatsappLink, productMessage, withBase } from '../../config';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { name, price, category, images, material, size, printTime, description, options } = product.data;

const CATN: Record<string, string> = {
  wall: 'Wall art',
  light: 'Lamps',
  desk: 'Desk',
  home: 'Home',
  fig: 'Figurines',
};

const waHref = whatsappLink(productMessage(name, price));

const ogImageSrc = images[0].src;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  image: new URL(ogImageSrc, Astro.site).toString(),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    price,
    availability: 'https://schema.org/MadeToOrder',
  },
};
---

<Layout
  title={`${name} — Aarvika 3D`}
  description={description}
  ogImage={ogImageSrc}
  ogType="product"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </Fragment>
  <Header />
  <main>
    <div class="max-w-6xl mx-auto px-5 py-10 md:py-14">
      <a href={withBase('shop')} class="text-sm text-dust hover:text-bone transition-colors">← Back to shop</a>

      <div class="mt-6 grid gap-10 md:grid-cols-2">
        <div>
          <div id="gallery-main" class="overflow-hidden rounded-xl border border-line bg-ink-3">
            {
              images.map((img, i) => (
                <Image
                  src={img}
                  alt={`${name} — ${material}`}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 768px) 500px, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class:list={['gallery-slide aspect-square w-full object-cover', { hidden: i !== 0 }]}
                  data-index={i}
                />
              ))
            }
          </div>
          {
            images.length > 1 && (
              <div class="mt-3 flex gap-2">
                {images.map((img, i) => (
                  <button
                    type="button"
                    class="gallery-thumb overflow-hidden rounded-lg border-2 aria-current:border-coral border-transparent"
                    data-index={i}
                    aria-current={i === 0}
                    aria-label={`Show photo ${i + 1} of ${name}`}
                  >
                    <Image src={img} alt="" width={80} height={80} class="h-16 w-16 object-cover" />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-coral">{CATN[category]}</p>
          <h1 class="mt-2 font-display text-2xl font-medium text-bone md:text-3xl">{name}</h1>
          <p class="mt-2 text-xl font-medium text-coral">₹{price.toLocaleString('en-IN')}</p>
          <p class="mt-4 text-dust">{description}</p>

          {
            options.length > 0 && (
              <ul class="mt-5 space-y-1.5 text-sm text-dust">
                {options.map((opt) => (
                  <li class="flex gap-2">
                    <span class="text-coral">·</span>
                    {opt}
                  </li>
                ))}
              </ul>
            )
          }

          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 flex w-full items-center justify-center rounded-full bg-coral px-5 py-3 text-sm font-medium text-coral-ink transition-colors hover:bg-coral-dp"
          >
            Order on WhatsApp
          </a>
          <p class="mt-3 text-xs text-dust-2">
            Opens a chat with this piece filled in. We confirm colour, price and timeline there.
          </p>

          <div class="mt-8 grid grid-cols-2 gap-4 border-t border-line pt-6 text-sm">
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.13em] text-dust-2">Material</span>
              <span class="text-bone">{material}</span>
            </div>
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.13em] text-dust-2">Size</span>
              <span class="text-bone">{size}</span>
            </div>
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.13em] text-dust-2">Print time</span>
              <span class="text-bone">{printTime}</span>
            </div>
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.13em] text-dust-2">Dispatch</span>
              <span class="text-bone">3–5 working days</span>
            </div>
          </div>

          <p class="mt-6 text-xs text-dust-2">
            Made to order, so slight variation in layer texture is normal. Wipe with a dry cloth; keep
            away from direct sunlight and hot cars — PLA softens above roughly 55°C. Not dishwasher-safe
            or food-safe.
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const mainImages = document.querySelectorAll<HTMLElement>('.gallery-slide');
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const index = thumb.dataset.index;
      thumbs.forEach((t) => t.setAttribute('aria-current', String(t.dataset.index === index)));
      mainImages.forEach((img) => {
        img.classList.toggle('hidden', img.dataset.index !== index);
      });
    });
  });
</script>

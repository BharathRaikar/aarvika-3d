---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import workshop1 from '../assets/products/desk-organiser-tray-1.jpg';
import workshop2 from '../assets/products/desk-organiser-tray-2.jpg';
import workshop3 from '../assets/products/phone-stand-1.jpg';
---

<Layout
  title="About — Aarvika 3D"
  description="Five people, one Bambu A1, and a spare room in Bengaluru. The story behind Aarvika 3D."
>
  <Header />
  <main>
    <div class="max-w-6xl mx-auto grid gap-10 px-5 py-12 md:grid-cols-2 md:py-16">
      <div class="grid grid-cols-2 gap-3">
        <Image
          src={workshop1}
          alt="The Aarvika 3D workshop — a Bambu A1 printer and desk pieces in progress"
          widths={[300, 500]}
          sizes="(min-width: 768px) 260px, 45vw"
          class="col-span-2 aspect-video w-full rounded-xl border border-line object-cover"
        />
        <Image
          src={workshop2}
          alt="Printed desk organiser next to the workshop printer"
          widths={[200, 350]}
          sizes="(min-width: 768px) 200px, 45vw"
          class="aspect-square w-full rounded-xl border border-line object-cover"
        />
        <Image
          src={workshop3}
          alt="A print in progress on the workshop's 3D printer"
          widths={[200, 350]}
          sizes="(min-width: 768px) 200px, 45vw"
          class="aspect-square w-full rounded-xl border border-line object-cover"
        />
      </div>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-coral">Who we are</p>
        <h1 class="mt-3 font-display text-3xl font-medium text-bone md:text-4xl">
          Five of us, one printer, a spare room
        </h1>
        <p class="mt-5 text-dust">
          We pooled our money for a single machine and started printing things we wanted for
          our own desks. People asked where we got them. That turned into this.
        </p>
        <p class="mt-4 text-dust">
          We're still small enough that when you message, one of us reads it. If something
          arrives wrong, we reprint it — that's easier for us than arguing about it.
        </p>
        <p class="mt-6 text-sm text-dust-2">
          Bengaluru, India ·
          <a
            href="https://www.instagram.com/aarvika3d"
            target="_blank"
            rel="noopener noreferrer"
            class="text-coral hover:text-coral-dp"
          >
            @aarvika3d
          </a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
